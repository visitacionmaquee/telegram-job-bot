# ==============================================================================
# JobRadar AI — Environment Configuration
# ==============================================================================

# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_USER_ID=your_numeric_telegram_user_id

# Database Configuration (PostgreSQL in production, SQLite fallback in dev)
POSTGRES_USER=jobradar
POSTGRES_PASSWORD=jobradar_secret_password_change_me
POSTGRES_DB=jobradar_db
DATABASE_URL=postgresql://jobradar:jobradar_secret_password_change_me@db:5432/jobradar_db

# Redis & Celery Task Queue
REDIS_URL=redis://redis:6379/0

# Job Radar Settings
DEFAULT_LOCATION=Philippines
MIN_MATCH_PERCENT=65
SCAN_INTERVAL_SECONDS=86400

# Optional Google Gemini API Key for AI synthesis (falls back to built-in smart engine if blank)
GEMINI_API_KEY=
